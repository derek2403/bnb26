CMC_API_KEY=
ATLAS_API_KEY=
KEEPER_PRIVATE_KEY=
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_MAINNET_RPC=https://bsc-dataseed.bnbchain.org

# ---------------------------------------------------------------- deploy scripts (contracts/script, Makefile)
# Private keys are 0x-prefixed hex. Scripts turn them into addresses locally; they are never printed.
# Testnet deployer (falls back to KEEPER_PRIVATE_KEY). Becomes deployer-only after the Timelock handoff.
DEPLOYER_PRIVATE_KEY=
# Mainnet deployer (falls back to MAINNET_PRIVATE_KEY). Never reuse a testnet key.
MAINNET_DEPLOYER_PRIVATE_KEY=
MAINNET_PRIVATE_KEY=
# BscScan via Etherscan V2 (one key for 97 and 56)
ETHERSCAN_API_KEY=

# Service keys (services/). Deploy scripts grant roles to their addresses when the *_ADDRESS override is unset.
MIRROR_PRIVATE_KEY=
MIRROR_BACKUP_PRIVATE_KEY=
RISK97_PRIVATE_KEY=
RISK56_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
OPS_PRIVATE_KEY=
ANCHOR_PRIVATE_KEY=
ANCHOR56_PRIVATE_KEY=
EVALUATOR_PRIVATE_KEY=

# Role holder overrides (addresses; optional). Fallback: the key above, then KEEPER_PRIVATE_KEY, then the deployer.
GUARDIAN_ADDRESS=
KEEPER_ADDRESS=
RISK_POSTER_ADDRESS=
AGENT_ADDRESS=
MIRROR_PUSHER_ADDRESS=
MIRROR_BACKUP_ADDRESS=
ANCHOR_ADDRESS=
SCENARIO_OPERATOR_ADDRESS=
MAINNET_KEEPER_ADDRESS=
ANCHOR56_ADDRESS=
MAINNET_GUARDIAN_ADDRESS=
AGENT56_ADDRESS=

# DeployCore (all optional; defaults in brackets)
# HANDOFF_ADMIN [false]: true moves DEFAULT_ADMIN_ROLE to the Timelock at the end of deploy-core.
HANDOFF_ADMIN=
TIMELOCK_DELAY=
TIMELOCK_PROPOSER=
TIMELOCK_EXECUTOR=
# Prices used for ScenarioFeed anchors and PCS v2 pair seeding, WAD (1e18 = $1) [150e18, 400e18, 554.69e18]
NVDA_PRICE_E18=
TSLA_PRICE_E18=
BNB_PRICE_E18=
MUSDC_DECIMALS=
TNVDA_FAUCET=
TTSLA_FAUCET=
MUSDC_FAUCET=
FAUCET_COOLDOWN=
# Atlas sources mirrored from BSC 56 and the pull feed ids (bytes4 of the Atlas registry id; NVDAB id UNVERIFIED)
ATLAS_NVDA_SRC_FEED=
ATLAS_TSLA_SRC_FEED=
ATLAS_TSLA_MULTIFEED_ID=
ATLAS_BNB_USD_FEED=
ATLAS_PULL_FEED_ID_NVDA=
ATLAS_PULL_FEED_ID_TSLA=
# Dev/test only: accept this pull signer instead of the Atlas production key. Leave empty on real deploys.
ATLAS_PULL_SIGNER=
SANDBOX_SEED_TNVDA=
SANDBOX_STABLE_TNVDA=
SKIP_DEX=
PCS_V2_ROUTER=
WBNB=
LP_RECIPIENT=
PAIR_TNVDA_AMOUNT=
PAIR_TTSLA_AMOUNT=
PAIR_WBNB_MUSDC_BNB=
PAIR_WBNB_TNVDA_BNB=
POOL_LOGIC=
FRESH_DEPLOYMENTS_FILE=
DEPLOYMENTS_DIR=

# OpenDevPools
DEV_SEED_TNVDA=
SCENARIO_SEED_TNVDA=
SCENARIO_SEED_TTSLA=
DEV_SEED_RECIPIENT=
DEV_POOL_USE_MOCK_ROUTER=

# Flap launch scripts (DeployFlap, FlapLaunch; all optional, defaults in brackets)
# DeployFlap (immutable SplitStockConfig): ScenarioPool tranche + boost token default to pools[nvda-scenario].{pool,sUSD}
FLAP_SCENARIO_POOL=
FLAP_NO_SCENARIO=
FLAP_BOOST_TOKEN=
FLAP_NO_BOOST=
FLAP_POOL_SYMBOL=
# FlapLaunch.newLauncher: token + raise [SplitStock Backstop / SPLIT, 1.7e18 target, 0.2e18 seed, 3 days]
FLAP_LAUNCHER=
FLAP_NAME=
FLAP_SYMBOL=
FLAP_META=
FLAP_TARGET=
FLAP_SEED=
FLAP_SALE_DURATION=
FLAP_SALT=
FLAP_SALT_SEED=
# Allow the 97-only Flap/backstop scripts on another chain (fork simulation only)
ALLOW_NON_TESTNET=

# DeployBackstopTreasury [deployer, tTSLA, TSLA mirror]
TREASURY_ADMIN=
TREASURY_QUOTE_ASSET=
TREASURY_QUOTE_FEED=

# ConfigureRegistrar (CreatorRegistrar allowlists; default from deployments/97.json flap.launcherFactory, openfour.core/presetId)
REGISTRAR_FLAP_FACTORY=
REGISTRAR_OPENFOUR_CORE=
REGISTRAR_OPENFOUR_PRESET_ID=

# HandoffAdmin: extra AccessControl contracts (comma-separated) to hand to the Timelock
EXTRA_HANDOFF_TARGETS=

# DeployMainnet
PCS_V3_NVDAB_USDT=
NVDAB=
ALLOW_NON_MAINNET=

# ---------------------------------------------------------------- services/ (keeper, agent, API). Server-side only.
# Never prefix any of these with NEXT_PUBLIC_. Unset role keys make the matching job skip its writes.
CHAIN_ID=97
MAINNET_CHAIN_ID=56
# Keyed RPCs that allow eth_getLogs (indexer + Atlas source-tx lookup). Public BSC RPCs reject getLogs.
BSC_TESTNET_LOGS_RPC=
BSC_MAINNET_LOGS_RPC=
# ERC-8004 identity owner/wallet on mainnet (separate from AGENT_PRIVATE_KEY)
AGENT56_PRIVATE_KEY=
# Testnet role keys fall back to KEEPER_PRIVATE_KEY only when KEY_FALLBACK=keeper (dev only)
KEY_FALLBACK=none
# CoinMarketCap: REST key in header X-CMC_PRO_API_KEY; MCP key in header X-CMC-MCP-API-KEY (defaults to CMC_API_KEY)
CMC_MCP_API_KEY=
CMC_BASE_URL=https://pro-api.coinmarketcap.com
CMC_MCP_URL=https://mcp.coinmarketcap.com/mcp
CMC_DAILY_CREDIT_BUDGET=415
CMC_MONTHLY_CREDIT_LIMIT=15000
CMC_MCP_CREDITS_PER_CALL=1
# Optional JSON override of the CMC asset map, e.g. {"TSLA":{"cmcId":40214,"token":"0x…","rwaId":3}}
CMC_ASSETS=
# AI Risk Steward LLM: OpenAI-compatible endpoint, default Phala Private AI. LLM_API_KEY is accepted as an alias.
PHALA_AI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://inference.phala.com/v1
AGENT_MODEL=openai/gpt-oss-120b
# Completion budget incl. reasoning tokens (gpt-oss-120b truncated at 2000)
AGENT_MAX_TOKENS=8000
# Unused since the switch to Phala; still parsed
ANTHROPIC_API_KEY=
AGENT_EFFORT=high
AGENT_INTERVAL_SEC=3600
AGENT_DRY_RUN=false
AGENT_ID=
# Optional JSON override of the MCP tool plan: [{"tool":"get_global_metrics_latest","args":{},"ttlMs":3600000}]
AGENT_MCP_TOOLS=
# API
API_HOST=0.0.0.0
API_PORT=8080
KEEPER_TOKEN=
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=*
SERVE_RAW_BODIES=true
API_DOMAIN=
# Postgres (docker compose overrides DATABASE_URL with the internal host)
DATABASE_URL=postgres://splitstock:splitstock@localhost:5432/splitstock
POSTGRES_PASSWORD=
DB_DISABLED=false
# Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOW_BALANCE_WEI=20000000000000000
# Job tuning
# backstop-ops dispatches Flap tax every tick; false leaves dispatch() to a person (demo recording)
FLAP_DISPATCH=true
REBALANCE_FACTORY_POOLS=true
ARB_ENABLED=true
ARB_THRESHOLD_BPS=50
MAINNET_ENABLED=true
INDEXER_START_BLOCK_97=
INDEXER_START_BLOCK_56=
INDEXER_MAX_RANGE=2000
# GitHub Actions backup cron secrets (repository secrets, not this file): MIRROR_BACKUP_PRIVATE_KEY, OPS_BACKUP_PRIVATE_KEY
OPS_BACKUP_PRIVATE_KEY=

# ---------------------------------------------------------------- app/ (Next.js server routes; full list in app/.env.example)
SERVICES_API_URL=http://localhost:8080
DEMO_PRICES_TTL_SEC=600
ATLAS_PULL_FEED_IDS=
OF_UI_SIGNER_PRIVATE_KEY=
DRIP_PRIVATE_KEY=
DRIP_AMOUNT_WEI=5000000000000000
DRIP_CHALLENGE_SECRET=
# Public browser values (never secrets; NEXT_PUBLIC_*KEY* fails the app build)
NEXT_PUBLIC_WC_PROJECT_ID=
NEXT_PUBLIC_BSC_TESTNET_RPCS=
NEXT_PUBLIC_BSC_MAINNET_RPCS=
NEXT_PUBLIC_FLAP_TOKEN_URL_PREFIX=

# ---------------------------------------------------------------- openfour/ (Hardhat + fork-deploy)
# These are read from openfour/.env or openfour/startup/.env (hardhat.config.js does NOT load this root file).
# DEPLOYER_PRIVATE_KEY (above) is the fork Registry owner and Core.signer; never put it on the web server.
# Public RPC only (the config rejects keyed URLs).
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
RPC_URL=
GAS_PRICE_WEI=
GAS_LIMIT=
FORK_JSON=
DEPLOYMENTS_JSON=
REGISTRATION_JSON=
PRESET=
PRESET_ID=
BASELINE_PRESET_ID=
SKIP_BASELINE=
FEE_SOURCE_PRESET_ID=
BONDING_PRESET_ID=
# Address overrides for the preset (default: deployments/97.json)
BACKSTOP_TREASURY=
STOCK_TOKEN=
POOL_FACTORY=
STOCK_FEED=
SCENARIO_FEED=
POOL_ROUTER=
# lifecycle-splitstock.js switches
TOKEN_NAME=
TOKEN_SYMBOL=
DURATION=
FEED=
GRANT_CREATOR=
PARTNER=
TRADE_FEE_BPS=
SELL_OUT=
WAIT_FORCE=
POOL_ID=
CREATE_FEE=
# Upstream starter scripts (new-module.js, create-and-trade.js, register.js)
NAME=
TAG=
SLOT=
MIGRATE=
QUOTE_ASSET=
REQUEST_ID=
# fork-deploy (fork-from-chain.js / create-test-preset.js)
DRY_RUN=
SOURCE_DEPLOYMENT=
PROXY_DEPLOY_TX=
SIH_POOL_MANAGER=
FORWARD_VAULT=
REBATE_ADDRESS=
TAX_VAULT_TEMPLATE=
TAX_VAULT_INIT_DATA=
RAISE_AMOUNT=
BUY_BUDGET=
SELL=
SKIP_BUY=

