# SplitStock app (Next.js). Copy to app/.env.local. Everything below is SERVER-ONLY unless it starts with
# NEXT_PUBLIC_. The build fails if any NEXT_PUBLIC_*KEY* variable exists (scripts/check-env.mjs, next.config.mjs).

# services API (Fastify in services/) proxied by /api/state, /api/risk/*, /api/agent/*, /api/events/*, /api/logs/*,
# /api/cmc/usage, /api/backtest. KEEPER_TOKEN is sent as "Authorization: Bearer".
SERVICES_API_URL=http://localhost:8080
KEEPER_TOKEN=

# CoinMarketCap (server-side only; /api/demo-prices -> /v5/real-world-assets/quotes/latest, cached DEMO_PRICES_TTL_SEC)
CMC_API_KEY=
CMC_BASE_URL=https://pro-api.coinmarketcap.com
DEMO_PRICES_TTL_SEC=600

# Atlas pull API (/api/atlas/pull). Feed ids: decimal or bytes4 hex; ATLAS_PULL_FEED_IDS={"nvdab":"40215"} overrides.
ATLAS_API_KEY=
ATLAS_PULL_FEED_ID_NVDA=
ATLAS_PULL_FEED_ID_TSLA=
ATLAS_PULL_FEED_IDS=

# OpenFour fork create signer (= Core.signer() after setSigner(uiSigner)); used only by /api/openfour/sign-create
OF_UI_SIGNER_PRIVATE_KEY=

# Testnet gas drip (/api/drip): 0.005 tBNB once per wallet per day
DRIP_PRIVATE_KEY=
DRIP_AMOUNT_WEI=5000000000000000
DRIP_CHALLENGE_SECRET=

# Server RPCs (comma-separated fallback lists allowed)
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_MAINNET_RPC=https://bsc-dataseed.bnbchain.org

# Public (browser) values: never secrets
NEXT_PUBLIC_WC_PROJECT_ID=
NEXT_PUBLIC_BSC_TESTNET_RPCS=
NEXT_PUBLIC_BSC_MAINNET_RPCS=
NEXT_PUBLIC_FLAP_TOKEN_URL_PREFIX=
